{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Profiles",
  "version": "0.1.0",
  "identifier": "solo.indie.profiles",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node /home/dh/profiles-hackathon/server.mjs --port 1420",
    "beforeBuildCommand": "npm run sync-packs"
  },
  "app": {
    "windows": [
      {
        "title": "Profiles",
        "width": 1500,
        "height": 1020,
        "minWidth": 400,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:1420 http://localhost:8123 http://127.0.0.1:1420; img-src 'self' data: blob: http://localhost:1420 http://localhost:8123"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}