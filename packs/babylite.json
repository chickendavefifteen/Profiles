{
  "name": "babylite",
  "version": 1,
  "description": "babylite \u2014 soft baby-blue, big targets, one thing at a time. Auto-downshift when the machine struggles.",
  "ui": {
    "density": "spacious",
    "font_scale": 1.15,
    "target_min_px": 64,
    "palette": "baby-blue-soft",
    "animation_level": 0
  },
  "sensory_budget": {
    "max_animation": 0,
    "flash_hz": 0,
    "max_simultaneous": 0
  },
  "input": {
    "modes": [
      "pointer",
      "touch",
      "voice"
    ],
    "keybinds": {},
    "big_targets": true,
    "voice": true
  },
  "notifications": {
    "allow": [
      "family",
      "alarms"
    ],
    "quiet_hours": "21:00-08:00",
    "break_through": [
      "alarms"
    ]
  },
  "agent": {
    "verbosity": "plain",
    "proactivity": 0,
    "parallelism": 1,
    "autonomy": "suggest-only",
    "rest_reminders": false,
    "cadence_s": 900
  },
  "widgets": [
    "tasks",
    "notes"
  ],
  "routing": {
    "preferred_model": null
  }
}
