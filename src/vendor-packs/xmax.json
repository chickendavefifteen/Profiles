{
  "name": "xMAX",
  "version": 1,
  "description": "xMAX \u2014 Vibes + FOCUSMAX hybrid. Crisp, quick, heavy parallelism. Profile X only.",
  "ui": {
    "density": "compact",
    "font_scale": 1.0,
    "target_min_px": 44,
    "palette": "xmax-storm",
    "animation_level": 2
  },
  "sensory_budget": {
    "max_animation": 1.0,
    "flash_hz": 0,
    "max_simultaneous": 6
  },
  "input": {
    "modes": [
      "keyboard",
      "pointer",
      "voice"
    ],
    "keybinds": {
      "capture": "c",
      "complete-task": "e",
      "command": "k"
    },
    "big_targets": false,
    "voice": true
  },
  "notifications": {
    "allow": [
      "tasks",
      "calendar"
    ],
    "quiet_hours": null,
    "break_through": [
      "alarms"
    ]
  },
  "agent": {
    "verbosity": "detailed",
    "proactivity": 2,
    "parallelism": 6,
    "autonomy": "act-with-checkpoint",
    "rest_reminders": true,
    "cadence_s": 120
  },
  "widgets": [
    "tasks",
    "notes",
    "calendar",
    "files",
    "news"
  ],
  "routing": {
    "preferred_model": "muse-spark-1.3-contributor"
  }
}
